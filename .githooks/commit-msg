#!/bin/sh
# Guardrail: reject any AI authorship / co-author trailer in commit messages.
# This project ships no AI and is authored solely by the maintainer.
# Enable once per clone:  git config core.hooksPath .githooks
msg_file="$1"
if grep -Eiq 'co-authored-by:[[:space:]]*(claude|anthropic)|generated with[[:space:]]+(\[?claude|anthropic)|noreply@anthropic|anthropic\.com|\bclaude (code|opus|sonnet|haiku)\b' "$msg_file"; then
  echo "commit-msg hook: refusing commit — AI authorship/co-author trailer detected." >&2
  echo "Commits must be authored solely by the maintainer (no AI attribution)." >&2
  exit 1
fi
exit 0
